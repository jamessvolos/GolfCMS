# SQLite dev database. Optional — this exact value is the built-in default.
# Point it at Postgres later without touching code.
DATABASE_URL="file:./prisma/dev.db"

# Set to 1 only in sandboxed dev containers whose browsers can't reach Esri
# directly; routes map tiles through /api/tiles (see lib/map/groundStyle.ts).
# NEXT_PUBLIC_TILE_PROXY=1

# Gates /admin and /api/admin. Unset in development means the admin tools
# are open locally, which is the point. Unset in PRODUCTION means they are
# disabled outright (503) rather than exposed. At least 16 characters —
# nothing rate-limits, so a short secret is not a gate.
#   SG_ADMIN_SECRET="$(openssl rand -base64 24)"
